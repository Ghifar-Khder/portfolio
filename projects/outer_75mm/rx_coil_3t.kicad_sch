(text "THREE DISTRIBUTED CAPACITORS" (at 60.96 48.26 0) (effects (font (size 2 2)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000028))
(text "C1, C2 and C3 lie 120 deg apart on the physical loop." (at 60.96 54.61 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000029))
(text "Copper arcs provide the loop inductance." (at 73.66 85.09 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-00000000002a))
(text "Wires here denote PCB connectivity;" (at 73.66 90.17 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-00000000002b))
(text "they are not a lumped RF simulation model." (at 73.66 95.25 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-00000000002c))
(text "C3: tuning branch" (at 85.09 124.46 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-00000000002d))
(text "C4: series match" (at 144.78 88.9 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-00000000002e))
(text "J1: 50 ohm measurement port" (at 190.5 99.06 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-00000000002f))
(text "1 = centre contact; 2 = shield" (at 190.5 104.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000030))
(text "DESIGN AND ASSEMBLY NOTES" (at 25.4 143.51 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000031))
(text "C1-C3: 1210 (3.2 x 2.5 mm), starting value 5 pF per handout. C4: 1210, provisional 5 pF start." (at 25.4 149.86 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000032))
(text "5 pF is NOT a final resonant design value. Distributed values may also need increasing during tuning." (at 25.4 154.94000000000003 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000033))
(text "Target: 123.26 MHz under the prescribed load. S11 < -20 dB is a measured acceptance target, not a CAD result." (at 25.4 160.02 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000034))
(text "75 mm OUTER copper diameter; trace centreline 70 mm; outer 75 mm; inner 65 mm; 5 mm trace; 35 um front copper." (at 25.4 165.10000000000002 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000035))
(text "Board/substrate assumption: nominal 1.6 mm FR4; no ground plane under the loop; SMA model is a candidate." (at 25.4 170.18 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000036))
(text "Matching topology is a proposed implementation. Confirm it and the supplied SMA before manufacturing." (at 25.4 175.26000000000002 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000037))
(text "No transmit detuning, preamplifier protection or scanner interface is included. Bench prototype only." (at 25.4 180.34 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid ba75c010-0000-4000-8000-000000000038))
